{
  "expo": {
    "name": "Tour Planner",
    "slug": "tour-planner",
    "scheme": "tourplanner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.saeed.tourplanner",
      "icon": {
        "light": "./assets/ios-light.png",
        "dark": "./assets/ios-dark.png",
        "tinted": "./assets/ios-tinted.png"
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze"
        ],
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "dev.saeed.tourplanner",
      "adaptiveIcon": {
        "backgroundColor": "#DC0032",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick screenshots of the scanner's stop list.",
          "cameraPermission": "Photograph the scanner's stop list to read the addresses."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Photograph the scanner's stop list and scan parcel labels.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Start or re-plan the route from where you are.",
          "locationAlwaysAndWhenInUsePermission": "Show the names, PRIO and time slot of a stop as you arrive there, and measure where the van stops during a tour to plan better routes, even with the app in the background.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "./plugins/withWidgetReleaseSettings",
      "./plugins/withSettingsBundle",
      "./plugins/withAndroidAppSettings",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "dev.saeed.tourplanner.widgets",
          "groupIdentifier": "group.dev.saeed.tourplanner",
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "NextStopWidget",
              "displayName": "Next stop",
              "description": "Your next delivery stop and how many are left.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "de"
          ]
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-light.png",
          "imageWidth": 220,
          "backgroundColor": "#DC0032",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#0A0A0C"
          }
        }
      ]
    ],
    "locales": {
      "en": "./locales/en.json",
      "de": "./locales/de.json"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
