<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's page in the iOS Settings app: the settings set once, mirrored both ways with the app's own
     (src/features/settings/systemSettings.ios.ts). Keys are the app's setting names. -->
<plist version="1.0">
<dict>
	<key>StringsTable</key>
	<string>Root</string>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Navigation</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Navigation app</string>
			<key>Key</key>
			<string>navApp</string>
			<key>DefaultValue</key>
			<string>apple</string>
			<key>Titles</key>
			<array>
				<string>Apple Maps</string>
				<string>Google Maps</string>
				<string>Waze</string>
			</array>
			<key>Values</key>
			<array>
				<string>apple</string>
				<string>google</string>
				<string>waze</string>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Auto-navigate</string>
			<key>Key</key>
			<string>autoNavigate</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Alerts</string>
			<key>FooterText</key>
			<string>Arrival details need location access set to Always.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Express reminders</string>
			<key>Key</key>
			<string>expressAlerts</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Arrival details</string>
			<key>Key</key>
			<string>arrivalAlerts</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>History and log</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Tour history</string>
			<key>Key</key>
			<string>keepHistory</string>
			<key>DefaultValue</key>
			<true/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Detailed log</string>
			<key>Key</key>
			<string>detailedLog</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
	</array>
</dict>
</plist>
